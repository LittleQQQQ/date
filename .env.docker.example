# 用 Docker 當主機時的設定：複製成 .env 再修改（.env 不會進 git，也不會打包進映像）。
# 每台主機各自一份；說明見 README「用 Docker 部署」。沒寫的設定用預設值，完整清單見 .env.example。

# ---------- 必填 ----------

# 資料庫密碼，自己取一個（第一次啟動後就固定了，之後要改得連資料一起重建）
DB_PASSWORD=

# ---------- 主機 ----------

# 對外的埠（預設 8000；這台同時在跑開發伺服器時可以改成 8080）
APP_PORT=8000

# LLM 備援（Jev 沒把握時）：預設用這台電腦上裝好的 Ollama（要先 ollama pull qwen2.5:3b）；
# 用 compose 裡的 ollama 容器就改成 http://ollama:11434 並加 --profile llm；留空 = 不用 LLM
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# 固定網址用的 Cloudflare 具名通道 token（輪流當主機的電腦填同一個）
CLOUDFLARE_TUNNEL_TOKEN=

# 對外網域，例如 date.example.com（多個用逗號分開）。外部 MCP 用戶端要連 /mcp 一定要填，
# 用同一個網路的 IP 連時也要把 IP 加進來，例如 date.example.com,192.168.1.20
MCP_ALLOWED_HOSTS=

# ---------- 外部服務（有才填） ----------

# 交通部 TDX：填了就每週更新台鐵、公車的班表與票價；留空用路網骨架的估計值
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Google Places API (New)：留空 = 餐廳只用 OSM。每月上限照日曆月計，每台主機各自計數（見 README）
GOOGLE_PLACES_API_KEY=
GOOGLE_NEARBY_MONTHLY_LIMIT=4750
GOOGLE_DETAILS_MONTHLY_LIMIT=950
GOOGLE_LOCATION_MONTHLY_LIMIT=9500

# Jev（TypeSafe）：mock = 規則模擬（沒有金鑰時用）；api = 正式 API
JEV_MODE=mock
TYPESAFE_API_KEY=

# ---------- 限流（每個 IP） ----------

API_READ_LIMIT_PER_MINUTE=60
API_PLAN_LIMIT_PER_HOUR=10
