# 用 Docker 當主機時的設定：複製成 .env 再修改（.env 不會進 git，也不會打包進映像）。
# 每台主機各自一份；說明見 README「用 Docker 部署」與「換主機」。

# 必填：資料庫密碼，自己取一個
DB_PASSWORD=

# 選用：對外的埠（預設 8000；這台同時在跑開發伺服器時可以改成 8080）
APP_PORT=8000

# 選用：用這台電腦上裝好的 Ollama（要先 ollama pull qwen2.5:3b）；留空 = 不用 LLM
OLLAMA_URL=http://host.docker.internal:11434

# 選用：固定網址用的 Cloudflare 具名通道 token（兩台主機填同一個）
CLOUDFLARE_TUNNEL_TOKEN=

# 選用：Google 地圖餐廳（有費用，每天最多呼叫 GOOGLE_PLACES_DAILY_LIMIT 次）
GOOGLE_PLACES_API_KEY=

# 選用：開放範圍（預設桃園市；留空 = 全台）
# ACTIVE_CITIES=桃園市
