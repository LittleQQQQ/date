# 複製成 .env 後修改。.env 不要放進版本控制。
# v2 改寫中：每完成一步，就把那一步用到的設定加進來（完整清單見後端規格書 8.2）。

# 資料庫：PostgreSQL ＋ PostGIS。下面是 compose.dev.yml 開發環境的網址（見 README「v2 開發環境」）
DATABASE_URL=postgresql+psycopg://date_planner:dev_only@localhost:5433/date_v2

# 交通部 TDX（https://tdx.transportdata.tw/ 免費註冊，會員中心 → 資料服務 → API 金鑰）。
# 填了就每週更新台鐵、公車的班表與票價；留空就用 data/network/ 的估計值
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Redis：佇列、鎖、限流、每月額度、快取（下面是 compose.dev.yml 開發環境的網址）
REDIS_URL=redis://localhost:6380/0

# Jev（TypeSafe）：mock = 規則模擬（沒有金鑰時用）；api = 正式 API（https://api.typesafe.ai/v1/systemone）
JEV_MODE=mock
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# 信心值低於這個值就交給 LLM 備援
JEV_CONFIDENCE_THRESHOLD=0.6

# Ollama：Jev 沒把握時的備援。留空 = 不用 LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Google Places API (New)：留空 = 不呼叫 Google，餐廳只用 OSM。
# 金鑰在 Google Cloud Console → API 和服務 → 憑證建立，建議限制只能呼叫「Places API (New)」
GOOGLE_PLACES_API_KEY=
# 自家的每月上限（次數，照日曆月計），達到就停止呼叫。預設是免費額度留 5% 邊際；
# 第一次試用可以先設小一點，例如 20 / 10 / 20，確認花費正常再改回預設
GOOGLE_NEARBY_MONTHLY_LIMIT=4750
GOOGLE_DETAILS_MONTHLY_LIMIT=950
GOOGLE_LOCATION_MONTHLY_LIMIT=9500
