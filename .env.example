# 複製成 .env 後修改。.env 不要放進版本控制。

# 資料庫：PostgreSQL ＋ PostGIS。下面是 compose.dev.yml 開發環境的網址（v2 改寫中，見 README「v2 開發環境」）
DATABASE_URL=postgresql+psycopg://date_planner:dev_only@localhost:5433/date_v2

# Jev：mock = 規則模擬（Demo 用）；api = 呼叫正式的 Jev API（介面見 app/jev/api_client.py）
JEV_MODE=mock
JEV_API_URL=
JEV_API_KEY=
# Jev 最高機率低於這個值，就請使用者確認
JEV_CONFIDENCE_THRESHOLD=0.6
# Jev 沒把握時先請本機 LLM（下面的 Ollama）幫忙判斷，LLM 也沒結果才請使用者確認；false = 一律請使用者確認
JEV_LLM_ASSIST=true
# 排程當下才問的判斷（片名比對、飲食限制）每次最多問 LLM 幾題；選片、選餐廳、選車不受限
JEV_LLM_ASSIST_MAX_CALLS=10

# LLM：本機 Ollama。OLLAMA_URL 留空 = 不用 LLM，只用規則解析
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 網頁排程呼叫 MCP 的方式：留空 = 同一個程序內連線；填網址 = 走 HTTP
MCP_CLIENT_URL=

# 爬蟲自動更新：true = 伺服器啟動時在背景補抓，之後每天 REFRESH_HOUR 點再抓
AUTO_REFRESH=true
REFRESH_HOUR=6

# 餐廳：Google Places API (New) 的金鑰。填了就在排程時即時查 Google 地圖（店家資料不存進資料庫）；
# 留空、查詢失敗或超過每日上限時，改用資料庫裡每週從 OSM 抓的餐廳
GOOGLE_PLACES_API_KEY=
# true = 多要評論、可訂位、素食、店家簡介（Enterprise + Atmosphere）；false = 只要營業時間、價位等（Enterprise）
GOOGLE_PLACES_ATMOSPHERE=true
# 程式每天最多呼叫 Google Places 幾次（台灣時間換日）；每個車站算一次
GOOGLE_PLACES_DAILY_LIMIT=30

# 交通：交通部 TDX（https://tdx.transportdata.tw/ 免費註冊，會員中心 → 資料服務 → API 金鑰）。
# 填了就每週從 TDX 更新台鐵、公車的班次與票價；留空就用 data/fixture/ 手寫的估計值
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 開放哪些縣市（逗號分隔，例如 桃園市,台北市）；留空 = 全台。
# 範圍外的縣市不列在選單、不能排程、不更新，但資料留在資料庫
ACTIVE_CITIES=桃園市
