# 複製成 .env 後修改。.env 不要放進版本控制。

# 資料庫：PostgreSQL（建立方式見 README）。留空就用專案資料夾裡的 SQLite（dev.db）
DATABASE_URL=postgresql+psycopg://date_planner:change_me@localhost:5432/date_planner

# Jev：mock = 規則模擬（Demo 用）；api = 呼叫正式的 Jev API（介面見 app/jev/api_client.py）
JEV_MODE=mock
JEV_API_URL=
JEV_API_KEY=
# Jev 最高機率低於這個值，就請使用者確認
JEV_CONFIDENCE_THRESHOLD=0.6

# LLM：本機 Ollama。OLLAMA_URL 留空 = 不用 LLM，只用規則解析
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 網頁排程呼叫 MCP 的方式：留空 = 同一個程序內連線；填網址 = 走 HTTP
MCP_CLIENT_URL=
